# ═══════════════════════════════════════════════════════════════
#  Konfiguracja środowiska — Platforma Treningowa (backend)
#
#  Skopiuj ten plik jako .env i uzupełnij puste wartości:
#      cp .env.example .env
#
#  .env jest w .gitignore i nigdy nie trafia do repozytorium.
# ═══════════════════════════════════════════════════════════════

# ---- Profil Spring -------------------------------------------
#  dev  — logi DEBUG, show-sql, Swagger włączony
#  prod — logi WARN, bez show-sql, Swagger wyłączony
SPRING_PROFILES_ACTIVE=dev

# ---- Baza danych ---------------------------------------------
DB_NAME=training_platform
DB_USER=tp_user
DB_PASSWORD=

# ---- Klucz podpisujący tokeny JWT ----------------------------
#  WYMAGANY. Aplikacja nie wstanie bez niego — i tak ma być.
#  Minimum 64 bajty losowe, nie fraza. Wygeneruj:
#      openssl rand -base64 64 | tr -d '\n'
#
#  Inny klucz na każdym środowisku. Podmiana klucza unieważnia
#  wszystkie wydane tokeny — użytkownicy muszą zalogować się ponownie.
JWT_SECRET=

#  Czas życia tokenu w milisekundach (86400000 = 24 h)
JWT_EXPIRATION=86400000

# ---- Konto administratora (bootstrap) ------------------------
#  Zakładane przy pierwszym starcie, gdy w bazie nie ma żadnego
#  konta z rolą ADMIN. Jeśli konto o tym adresie już istnieje,
#  zostaje promowane zamiast utworzone.
#  Puste ADMIN_PASSWORD = bootstrap pominięty (ostrzeżenie w logu).
ADMIN_EMAIL=admin@training.local
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Administrator
ADMIN_LAST_NAME=Systemu

# ---- Zaproszenia ---------------------------------------------
INVITATION_EXPIRATION_DAYS=7

#  Adres, pod który prowadzi link z maila — strona rejestracji
#  frontendu. Do linku dokleja się ?token=...
INVITATION_ACCEPT_BASE_URL=http://localhost:5173/register

# ---- Reset hasła ---------------------------------------------
#  Krótko celowo — reset robi się od razu, a długi termin to
#  niepotrzebnie szerokie okno dla kogoś, kto przejmie skrzynkę.
PASSWORD_RESET_EXPIRATION_MINUTES=60
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# ---- Wysyłka maili -------------------------------------------
#  log  — treść trafia do logu aplikacji, nic nie wychodzi na zewnątrz
#  smtp — realna wysyłka; lokalnie do Mailpita (http://localhost:8025)
MAIL_PROVIDER=smtp

#  Mailpit w sieci Dockera. Poza Dockerem: localhost
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=zaproszenia@trainingplatform.local

#  Mailpit nie wymaga uwierzytelniania ani szyfrowania.
#  U dostawcy produkcyjnego (B3) będzie odwrotnie:
#      MAIL_USERNAME / MAIL_PASSWORD z panelu dostawcy
#      MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true, MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ---- pgAdmin (wyłącznie lokalnie) ----------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=